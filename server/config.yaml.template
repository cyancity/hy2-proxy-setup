# Hysteria 2 服务端配置文件模板
# 目标路径: /etc/hysteria/config.yaml

# 监听端口（UDP）
listen: :__HY2_PORT__

# TLS 自签名证书配置
tls:
  cert: /etc/hysteria/server.crt
  key: /etc/hysteria/server.key

# 客户端认证方式（密码认证）
auth:
  type: password
  password: __HY2_PASSWORD__

# HTTP 流量伪装（防主动探测）
masquerade:
  type: proxy
  proxy:
    url: https://www.bing.com
    rewriteHost: true

# 带宽控制（留空或不配置则交由 BBR 自适应链路探测跑满速率）
# 若需要限制服务端速率可取消下方注释：
# bandwidth:
#   up: 50 mbps
#   down: 200 mbps
